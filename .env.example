# Authentik environment variables.
# Coolify: paste these into the application's Environment Variables tab.
# Locally: copy to .env and fill in. .env is gitignored.

# Postgres password — generate fresh: `openssl rand -base64 36 | tr -d '\n'`
PG_PASS=

# Authentik secret key — generate fresh: `openssl rand -base64 60 | tr -d '\n'`
# Used to sign cookies and tokens. Rotating it invalidates all sessions.
AUTHENTIK_SECRET_KEY=

# Cookie domain. Default in compose targets our VPS's nip.io parent
# (`3eee17bc.nip.io` = hex-encoded VPS IP). Override here when you move
# to a real domain (e.g. `auth.example.com`'s parent).
# AUTHENTIK_COOKIE_DOMAIN=3eee17bc.nip.io

# Image pinning. Bump deliberately; check release notes for breaking schema changes.
# AUTHENTIK_TAG=2026.2.2
